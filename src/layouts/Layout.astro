---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<link rel="icon" href={`${base}images/icon.png`} sizes="16x16">

	<meta content="text/html;charset=utf-8" http-equiv="Content-Type">
    <meta content="width=device-width, initial-scale=1.0" name="viewport" >
    <meta content="BiblioGames - Biblioteca de gestión de juegos de PC" name="description" >
    <meta content="Rubén Terré" name="author" >
    <!-- CSS Files
    ================================================== -->
    <link href={`${base}styles/bootstrap.min.css`} rel="stylesheet" type="text/css" id="bootstrap">
    <link href={`${base}styles/plugins.css`} rel="stylesheet" type="text/css" >
    <link href={`${base}styles/swiper.css`} rel="stylesheet" type="text/css" >
    <link href={`${base}styles/style.css`} rel="stylesheet" type="text/css" >
    <link href={`${base}styles/coloring.css`} rel="stylesheet" type="text/css" >
    <!-- color scheme -->
    <link id="colors" href={`${base}styles/colors/green-tech.css`} rel="stylesheet" type="text/css" >

		<meta name="generator" content={Astro.generator} />
		<title>BiblioGames</title>
	</head>
	<body class="dark-scheme">
		<slot />


	<!-- Javascript Files
    ================================================== -->
    <script is:inline src={`${base}scripts/plugins.js`}></script>
    <script is:inline src={`${base}scripts/designesia.js`}></script>
    <script is:inline src={`${base}scripts/jquery.countdown.js`}></script>
    <script is:inline src={`${base}scripts/countdown-custom.js`}></script>
    <script is:inline src={`${base}scripts/custom-marquee.js`}></script>
    <script is:inline src={`${base}scripts/custom-swiper-2.js`}></script>

	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
