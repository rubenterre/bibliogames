---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  pathname?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = "BiblioGames",
  description = "Biblioteca digital para la gestión y consulta de un catálogo de videojuegos físicos de PC y Xbox.",
  image = "images/pwa/opengraph-image.jpg",
  pathname = "",
  type = "website",
  noindex = false,
} = Astro.props;

const site = Astro.site?.toString() ?? "https://rubenterre.github.io";
const base = import.meta.env.BASE_URL;

const normalizePath = (value: string) => {
  if (!value) return "";
  return value.startsWith("/") ? value.slice(1) : value;
};

const normalizedPathname = pathname
  ? pathname.startsWith("/")
    ? pathname
    : `/${pathname}`
  : base;

const canonical = new URL(normalizedPathname, site).toString();
const imagePath = image.startsWith("http")
  ? image
  : new URL(`${base}${normalizePath(image)}`, site).toString();
---

<link rel="canonical" href={canonical} />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />

<meta property="og:site_name" content="BiblioGames" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagePath} />
<meta property="og:locale" content="es_ES" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imagePath} />
